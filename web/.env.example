# Base URL prefix for the Headwind REST API.
# Leave as "/rest" to use the Vite dev proxy (see vite.config.ts) or to be
# served from the same origin as the server in production.
# Set to an absolute URL (e.g. https://mdm.example.com/rest) to target a
# remote server directly. Note: cross-origin requests require the server to
# send CORS + credentialed-cookie headers, since auth is session based.
VITE_API_BASE=/rest

# Dev-only: where the Vite proxy forwards /rest, /files, /agent/ws, /update and /recovery.
# Default: the dev stack's Caddy (docker-compose.dev.yml), which routes them as production does.
# Consumed by vite.config.ts, not by the app at runtime.
VITE_DEV_PROXY_TARGET=http://localhost:8088

# Server origin embedded in the enrollment QR payload (both the APK download
# location and com.mdmesh.SERVER_URL). Defaults to window.location.origin.
# A factory-reset phone cannot reach a dev machine's localhost — when enrolling
# a real device during development, point this at an address the phone can reach
# (e.g. the LAN IP), then restart the dev server.
# VITE_PUBLIC_BASE_URL=http://192.168.1.10:5173
